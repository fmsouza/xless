# libdmg-hfsplus (GPL-3; external `dmg` + `hfsplus` tools in the xless-tauri image, never linked into xless) for
# Linux-built DMGs. mozilla/libdmg-hfsplus is the maintained fork (fanquake's is archived and keeps only `dmg`);
# this commit has `hfsplus … symlink` and `addall --symlinks clone_link`. sha256 of the GitHub source tarball
# https://github.com/mozilla/libdmg-hfsplus/archive/<commit>.tar.gz computed locally (trust-on-first-use).
LIBDMG_HFSPLUS_COMMIT=ec239599c1f234a4e01ae3fe51214d0c77e5baa3
LIBDMG_HFSPLUS_SHA256=190e29e4e0bd53e31af1f617b62dcd46b300ffbb0b7cd9e1bf49adb218872763
# xless-rn image (React Native / Expo iOS). Ruby from source: Bundler 2.7 needs Ruby >= 3.2 and jammy ships 3.0;
# 3.4.8 matches the acceptance app's .tool-versions. sha256 from ruby-lang.org's published release list. The CocoaPods
# gem is not in the image: each app's Gemfile.lock decides it, installed through Bundler at prepare time.
RN_RUBY_VERSION=3.4.8
RN_RUBY_SHA256=53c4ddad41fbb6189f1f5ee0db57a51d54bd1f87f8755b3d68604156a35b045b
# Bundler gem from rubygems.org; sha256 as published by the rubygems.org versions API.
RN_BUNDLER_VERSION=2.7.2
RN_BUNDLER_SHA256=1decaf9e2e1acb91b6586a2925c8f3f6da2334a82731a62ff2ded1b83c283871
# swiftlang/swift-build at the tag matching SWIFT_VERSION, built with SWIFTCI_USE_LOCAL_DEPS=1 against sibling
# checkouts pinned as in swiftlang/swift's update-checkout-config.json (release/6.4.0 scheme): swift-driver, llbuild,
# swift-tools-support-core and swift-tools-protocols at the same swift-*-RELEASE tag; swift-argument-parser,
# swift-system and swift-toolchain-sqlite at their listed versions. sha256s of the GitHub tag source tarballs
# (https://github.com/<org>/<repo>/archive/refs/tags/<tag>.tar.gz) computed locally (trust-on-first-use).
SWB_TAG=swift-6.4.0-RELEASE
SWB_SHA256=5a7f1f35ae8783ca7d5791f68110dfba663f647307a4fc2e076e325efc603855
SWB_DRIVER_SHA256=aecca17753f5f9b03867a92e568ab9a0023159928afb02e9ff496e1430c6d0b6
SWB_LLBUILD_SHA256=4ea396e158eea664deffdf414c93872cc8e512b42bdd4bb29ad4cbdb108097aa
SWB_TSC_SHA256=4daaf31f3b020b28813e2a67d651b3efdf7be9b38b25902e8180bd46ba57fe07
SWB_TOOLS_PROTOCOLS_SHA256=5c73f3fb051e00a1faf9e4c1a9dc2b99f3d43ccf72a757224e8c1984bf214cc9
SWB_ARGUMENT_PARSER_VERSION=1.6.1
