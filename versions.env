# hermesc built from facebook/hermes for the host arch (React Native ships an x86_64-only Linux hermesc).
# Version mapping: react-native 0.86.2 -> sdks/.hermesv1version = hermes-v250829098.0.16 (Hermes V1, the default:
# hermes-utils.rb enables it unless RCT_HERMES_V1_ENABLED=0) = npm hermes-compiler 250829098.0.16 (gitHead
# 90f23852efcd361315688e2904d2446707fa274c, the tag's commit). The legacy engine (sdks/.hermesversion) is hermes-v0.17.0.
# sha256 of https://github.com/facebook/hermes/archive/refs/tags/<tag>.tar.gz computed locally (trust-on-first-use).
HERMES_TAG=hermes-v250829098.0.16
HERMES_SHA256=25c4180de4fb7b2a7809fa288be9288c187cbc161c5cdf2bf4ab2ec1e8afaa99
# The supported Xcode releases (what `xless setup` can build images from), one set of keys per Xcode build <B>:
#   XCODE_RELEASES              the supported Xcode builds, space separated
#   XCODE_SHORT_<B>             the marketing version (CFBundleShortVersionString), e.g. 26.2
#   XCODE_APPLE_SWIFT_<B>       the Swift version Apple's toolchain in that Xcode reports (Ruling R10 maps it to XCODE_SWIFT_<B>)
#   XCODE_BUILD_MACHINE_OS_<B>  the BuildMachineOSBuild Xcode stamps into the apps it builds
#   XCODE_XIP_SHA256_<B>        SHA-256 of each known Xcode_<version>.xip download of that release, space separated
#                               (identification is by content, never by file name; empty until recorded)
#                               Each recorded download was vetted once: the toolchain-meta.json built from its `xtool sdk build`
#                               export equals the reference one measured from that Xcode (same SDK and platform builds), and its
#                               macOS SDK and Swift macOS runtime carry x86_64 slices. 17C52: Xcode_26.2_Universal.xip, then
#                               Xcode_26.2_Apple_silicon.xip; 27A266a: Xcode_27.xip.
# The Apple Swift and BuildMachineOSBuild values were measured once, black-box, on the maintainer's Mac
# (`swift --version` of the Xcode's default toolchain; `sw_vers -buildVersion`); no run of xless executes an Apple tool.
XCODE_RELEASES="17C52 27A266a"
XCODE_SHORT_17C52=26.2
XCODE_SHORT_27A266a=27.0
XCODE_APPLE_SWIFT_17C52=6.2.3
XCODE_APPLE_SWIFT_27A266a=6.4
XCODE_BUILD_MACHINE_OS_17C52=26A434
XCODE_BUILD_MACHINE_OS_27A266a=26A434
XCODE_XIP_SHA256_17C52="8f29ab6a9ac6670d3cf53545ffdb1c317d11607fa8db38fc56d3391df7783fbd 6df31d543c641fe8d18900f716113c76e7a0ec2d3b39ce8c86f30e2602f6b552"
XCODE_XIP_SHA256_27A266a="6a270c53a5a0c5e0ac78125342d44c3cfff2716ec390373cd5e30834d80a67c3"
# Ruling R10: app code is compiled by the Swift toolchain the project's Xcode ships. XCODE_SWIFT_<Xcode build> maps an
# Xcode to an open-source Swift release, measured black-box from that Xcode (its default toolchain's `swift --version`)
# and chosen by one rule: the same major.minor as Apple's Swift, and the highest patch release not above Apple's (Apple's
# Swift can be ahead of the open-source tags). `make images` (scripts/xcode-swift.sh) refuses an Xcode without an entry
# or whose Swift breaks the rule; prepare and the build stage check the image's toolchain against the Xcode's Swift again. A release
# equal to SWIFT_VERSION is the image's own Swift (nothing downloaded).
#   Xcode 26.2 (17C52):   Apple Swift version 6.2.3 (swiftlang-6.2.3.3.21 clang-1700.6.3.2) -> swift-6.2.3-RELEASE
#   Xcode 27.0 (27A266a): Apple Swift version 6.4 (swiftlang-6.4.0.34.1 clang-2100.3.34.1)   -> swift-6.4.0-RELEASE
#   Xcode 27.1 (27A9275): Apple Swift version 6.4 (swiftlang-6.4.0.34.1 clang-2100.3.34.1)   -> swift-6.4.0-RELEASE
XCODE_SWIFT_17C52=6.2.3
XCODE_SWIFT_27A266a=6.4.0
XCODE_SWIFT_27A9275=6.4.0
# swift.org's Ubuntu 22.04 toolchain tarballs of each mapped release other than SWIFT_VERSION (SWIFT_TOOLCHAIN_<x_y_z>_*).
# sha256s computed locally from the downloads (trust-on-first-use); their .sig files were also checked once against
# https://www.swift.org/keys/all-keys.asc ("Swift 6.x Release Signing Key"), which the image build does not repeat.
SWIFT_TOOLCHAIN_6_2_3_URL_AARCH64=https://download.swift.org/swift-6.2.3-release/ubuntu2204-aarch64/swift-6.2.3-RELEASE/swift-6.2.3-RELEASE-ubuntu22.04-aarch64.tar.gz
SWIFT_TOOLCHAIN_6_2_3_SHA256_AARCH64=fbb4282ec60107cc844700aac6c7a8115534defb1c9b36867bd77c0829e5b163
SWIFT_TOOLCHAIN_6_2_3_URL_X86_64=https://download.swift.org/swift-6.2.3-release/ubuntu2204/swift-6.2.3-RELEASE/swift-6.2.3-RELEASE-ubuntu22.04.tar.gz
SWIFT_TOOLCHAIN_6_2_3_SHA256_X86_64=23653abba4b153aa6625f73e63e3f119bdaf18363b00e3770a306fbd9b192aef
# SWIFT_VERSION's own tarballs: the images start from the swift image instead, but a native install (`xless setup`
# without --docker) downloads them. sha256s computed locally from the downloads on 2026-11-02 (trust-on-first-use; the
# .sig files were not checked).
SWIFT_TOOLCHAIN_6_4_0_URL_AARCH64=https://download.swift.org/swift-6.4.0-release/ubuntu2204-aarch64/swift-6.4.0-RELEASE/swift-6.4.0-RELEASE-ubuntu22.04-aarch64.tar.gz
SWIFT_TOOLCHAIN_6_4_0_SHA256_AARCH64=28c28acb2b91ed0e3beff5e6ba3695a785e645d9bd374adcaa3b7c2a901bc763
SWIFT_TOOLCHAIN_6_4_0_URL_X86_64=https://download.swift.org/swift-6.4.0-release/ubuntu2204/swift-6.4.0-RELEASE/swift-6.4.0-RELEASE-ubuntu22.04.tar.gz
SWIFT_TOOLCHAIN_6_4_0_SHA256_X86_64=bce85ea80f1471b85f39993f9285dbc798ec8e1eac5f677e24b2ac693856f9f8
