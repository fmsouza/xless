SWIFT_VERSION=6.4.0
# SWIFT_IMAGE: the swift:<SWIFT_VERSION>-jammy image, pinned by its multi-arch index digest (from `docker buildx imagetools
# inspect swift:6.4.0-jammy` on 2026-10-20). The image chain (docker/Dockerfile.base, docker/Dockerfile.rn), `make
# test-linux` and the CI containers that build the released binaries all use it. The workflows can't read this file, so
# .github/workflows/*.yml repeat the reference; Tests/shell/swift-image.test.sh fails when they differ from it, or when its
# tag isn't SWIFT_VERSION's. To bump: change SWIFT_VERSION and SWIFT_IMAGE here, then the workflows' `container:` lines.
SWIFT_IMAGE=swift:6.4.0-jammy@sha256:11bb836ebbc05dbe59b28ffa6cb6ca6b452375d7a65b322c5b6c83f44d52f8c0
XTOOL_VERSION=1.21.0
RCODESIGN_VERSION=0.29.0
# ASSETKIT_REVISION: upstream xtool-org/AssetKit revision that ThirdParty/AssetKit (vendored, patched) is based on; patches listed in ThirdParty/AssetKit/README.md
ASSETKIT_REVISION=e763558b55fcbb5a443b1d7b2c6f0972d8bd14f7
XLESS_VERSION=0.0.0-dev
# The free disk space (GB) `xless setup` asks for before it starts, per architecture it builds; an environment variable
# of the same name overrides each. Measured on first runs from the Xcode 26.2 and 27.0 .xips (docs/acceptance-m5.md):
#   XLESS_SETUP_CACHE_GB   under the cache ($XDG_CACHE_HOME/xless, default ~/.cache/xless): xtool expands the .xip into
#                          the SDK export there. Measured peak 14.9 GB (Xcode 26.2 Universal; 27.0: 12.9), plus ~2 GB;
#                          about 3.5 GB stays. A stock 19 GB VM root disk (18 GB free) still passes. Counted only for
#                          an architecture whose SDK this run exports.
#   XLESS_SETUP_DOCKER_GB  under Docker's data root (checked on Linux): the four images and their build cache. Measured
#                          31 GB for a first chain on a fresh machine (Xcode 27.0 arm64), plus ~9 GB.
#   XLESS_SETUP_NATIVE_GB  under the native home ($XLESS_NATIVE_HOME, default ~/.local/share/xless-native) and the
#                          SDK install (~/.config): a native setup's Swift toolchain (~4 GB unpacked, plus its ~1.1 GB
#                          download), xtool and rcodesign, and the installed SDK (~3.5 GB). Estimated, plus ~1 GB.
# GB here and in the check are decimal (10^9 bytes).
XLESS_SETUP_CACHE_GB=17
XLESS_SETUP_DOCKER_GB=40
XLESS_SETUP_NATIVE_GB=10
XCODE_VERSION=27.0
XCODE_BUILD=27A266a
XTOOL_SHA256_AARCH64=470d55880379de9696a048f4293a0b05a7fc43beba423ffe6c294a4975dcebf7
XTOOL_SHA256_X86_64=e2277e59bb2fda9b487cbc77ad080ea2b0370bb740ac0f02cc42fa28a272d3a5
RCODESIGN_SHA256_AARCH64=4af92c87ddf52f5f2d1258a3b4e56c7dcb8f1b2468df744976c5f139e031961f
RCODESIGN_SHA256_X86_64=dbe85cedd8ee4217b64e9a0e4c2aef92ab8bcaaa41f20bde99781ff02e600002
# STATIC_SDK_SHA256 was computed locally from the download (trust-on-first-use); swift.org PGP signature not verified
STATIC_SDK_URL=https://download.swift.org/swift-6.4.0-release/static-sdk/swift-6.4.0-RELEASE/swift-6.4.0-RELEASE_static-linux-0.1.0.artifactbundle.tar.gz
