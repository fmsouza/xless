#!/bin/sh
# xless-credential-pass: keeps xless's secrets in pass, the standard Unix password manager (passwordstore.org), as
#   xless/<NAME>/secret     the value, byte for byte
#   xless/<NAME>/username   its kind and IDs, as xless describes them (not secret)
# both encrypted with your pass GPG key. It speaks xless's credential-helper protocol (docs/secrets.md#writing-a-credential-helper):
#   xless-credential-pass get | store | erase | list      (requests on stdin, answers on stdout, JSON)
# To use it, put it on PATH and choose it in ~/.config/xless/config.yml:
#   ln -s <prefix>/share/xless/credential-helpers/xless-credential-pass ~/.local/bin/
#   secrets: { backend: helper, helper: pass }
# GnuPG asks your key's passphrase through its agent (set GPG_TTY=$(tty) for a terminal pinentry). Needs pass and awk.
# Secrets pass between commands as `printf '%s' "$value" | …`: printf is a builtin of every sh this runs with (dash,
# bash, busybox, ksh), so a value never becomes an argument of a new process.
set -eu
LC_ALL=C
export LC_ALL
me=xless-credential-pass
not_found="credentials not found in native keychain"
dir=${PASSWORD_STORE_DIR:-$HOME/.password-store}

die() {
  printf '%s: %s\n' "$me" "$1" >&2
  exit 1
}

# json_check KEY / json_get KEY: stdin is a flat JSON object of strings. check: it is one, and it has KEY. get: prints
# KEY's value, decoded, exactly (run check first: get prints as it reads).
# shellcheck disable=SC2016 # an awk program: its $0 is awk's
json_awk='
function fail(m) { printf "%s: the request is not valid JSON (%s)\n", me, m > "/dev/stderr"; exit 2 }
function ws() { while (i <= n && index(" \t\r\n", substr(s, i, 1))) i++ }
function hex(h,   k, d, v) {
  v = 0
  for (k = 1; k <= 4; k++) {
    d = index("0123456789abcdef", tolower(substr(h, k, 1)))
    if (!d) fail("bad \\u escape")
    v = v * 16 + d - 1
  }
  return v
}
function str(emit, keep,   c, e, v, out) {
  if (substr(s, i, 1) != "\"") fail("a string was expected")
  i++
  out = ""
  for (;;) {
    if (i > n) fail("unterminated string")
    c = substr(s, i, 1)
    i++
    if (c == "\"") return out
    if (c == "\\") {
      e = substr(s, i, 1)
      i++
      if (e == "n") c = "\n"
      else if (e == "t") c = "\t"
      else if (e == "r") c = "\r"
      else if (e == "b") c = "\b"
      else if (e == "f") c = "\f"
      else if (e == "\"" || e == "\\" || e == "/") c = e
      else if (e == "u") {
        v = hex(substr(s, i, 4))
        i += 4
        if (v < 1 || v > 127) fail("only \\u0001-\\u007f escapes are read; xless writes other characters as UTF-8")
        c = sprintf("%c", v)
      } else fail("bad escape")
    }
    if (emit) printf "%s", c
    if (keep) out = out c
  }
}
{ s = s (NR > 1 ? "\n" : "") $0 }
END {
  n = length(s)
  i = 1
  ws()
  if (substr(s, i, 1) != "{") fail("an object was expected")
  i++
  ws()
  found = 0
  if (substr(s, i, 1) == "}") i++
  else for (;;) {
    ws()
    k = str(0, 1)
    ws()
    if (substr(s, i, 1) != ":") fail("a colon was expected")
    i++
    ws()
    if (k == want) found = 1
    str(k == want && mode == "get", 0)
    ws()
    c = substr(s, i, 1)
    i++
    if (c == "}") break
    if (c != ",") fail("a comma or a closing brace was expected")
  }
  ws()
  if (i <= n) fail("bytes after the object")
  if (!found) fail("no " want)
}'
json_check() { awk -v me="$me" -v mode=check -v want="$1" "$json_awk"; }
json_get() { awk -v me="$me" -v mode=get -v want="$1" "$json_awk"; }

# json_string: stdin is a value followed by one "x" (so trailing newlines survive $(...)); prints it as a JSON string.
json_string() {
  awk '
BEGIN {
  for (k = 1; k < 32; k++) esc[sprintf("%c", k)] = sprintf("\\u%04x", k)
  esc["\t"] = "\\t"; esc["\r"] = "\\r"; esc["\b"] = "\\b"; esc["\f"] = "\\f"
  esc[sprintf("%c", 127)] = "\\u007f"; esc["\""] = "\\\""; esc["\\"] = "\\\\"
}
{ line[NR] = $0 }
END {
  sub(/x$/, "", line[NR])
  printf "\""
  for (r = 1; r <= NR; r++) {
    if (r > 1) printf "\\n"
    m = length(line[r])
    for (k = 1; k <= m; k++) { c = substr(line[r], k, 1); printf "%s", ((c in esc) ? esc[c] : c) }
  }
  printf "\""
}'
}

# The entry name in a ServerURL (xless:<NAME>); anything else is refused.
name_of() {
  case $1 in
    xless:*) n=${1#xless:} ;;
    *) die "not an xless credential: $1" ;;
  esac
  case $n in
    '' | [!A-Za-z0-9]* | *[!A-Za-z0-9._@-]*) die "not an xless entry name: $n" ;;
  esac
  printf '%s' "$n"
}

# The content of a pass entry, followed by "x".
show() { pass show "$1" && printf x; }

command -v pass >/dev/null 2>&1 || die "pass is not installed (passwordstore.org)"

case ${1:-} in
  get)
    url=$(cat)
    name=$(name_of "$url") || exit 1
    if [ ! -f "$dir/xless/$name/secret.gpg" ]; then
      echo "$not_found"
      exit 1
    fi
    secret=$(show "xless/$name/secret") || die "pass could not read xless/$name/secret"
    user=$(show "xless/$name/username") || die "pass could not read xless/$name/username"
    printf '{"ServerURL":"xless:%s","Username":%s,"Secret":%s}\n' "$name" \
      "$(printf '%s' "$user" | json_string)" "$(printf '%s' "$secret" | json_string)"
    ;;
  store)
    request=$(cat)
    for key in ServerURL Username Secret; do printf '%s' "$request" | json_check "$key" || exit 1; done
    name=$(name_of "$(printf '%s' "$request" | json_get ServerURL)") || exit 1
    printf '%s' "$request" | json_get Username | pass insert --multiline --force "xless/$name/username" >/dev/null
    printf '%s' "$request" | json_get Secret | pass insert --multiline --force "xless/$name/secret" >/dev/null
    ;;
  erase)
    url=$(cat)
    name=$(name_of "$url") || exit 1
    [ -d "$dir/xless/$name" ] || { echo "$not_found"; exit 1; }
    pass rm --recursive --force "xless/$name" >/dev/null
    ;;
  list)
    out='{'
    sep=''
    for entry in "$dir"/xless/*/; do
      [ -f "${entry}secret.gpg" ] || continue
      name=$(basename "$entry")
      case $name in [!A-Za-z0-9]* | *[!A-Za-z0-9._@-]*) continue ;; esac
      user=$(show "xless/$name/username") || die "pass could not read xless/$name/username"
      out="$out$sep\"xless:$name\":$(printf '%s' "$user" | json_string)"
      sep=','
    done
    printf '%s}\n' "$out"
    ;;
  *)
    echo "usage: $me get|store|erase|list (xless's credential-helper protocol; see docs/secrets.md)" >&2
    exit 2
    ;;
esac
