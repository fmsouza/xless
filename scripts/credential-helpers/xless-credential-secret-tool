#!/bin/sh
# xless-credential-secret-tool: keeps xless's secrets in your desktop keyring (GNOME Keyring, KWallet, KeePassXC… through
# the Secret Service D-Bus API) with libsecret's secret-tool, one item per secret: attributes application=xless and
# xless-name=<NAME>, label "xless <NAME> <its kind and IDs, as xless describes them>" (not secret; in the label because
# `secret-tool search` prints labels on stdout, attributes on stderr). secret-tool takes values of less than 8 KiB.
# It speaks xless's credential-helper protocol (docs/secrets.md#writing-a-credential-helper):
#   xless-credential-secret-tool get | store | erase | list      (requests on stdin, answers on stdout, JSON)
# To use it, put it on PATH and choose it in ~/.config/xless/config.yml:
#   ln -s <prefix>/share/xless/credential-helpers/xless-credential-secret-tool ~/.local/bin/
#   secrets: { backend: helper, helper: secret-tool }
# The keyring asks to be unlocked in its own window when it is locked. Needs secret-tool (libsecret-tools) and awk.
# Secrets pass between commands as `printf '%s' "$value" | …`: printf is a builtin of every sh this runs with (dash,
# bash, busybox, ksh), so a value never becomes an argument of a new process.
set -eu
LC_ALL=C
export LC_ALL
me=xless-credential-secret-tool
not_found="credentials not found in native keychain"
tab=$(printf '\t')
nl='
'

die() {
  printf '%s: %s\n' "$me" "$1" >&2
  exit 1
}

# json_check KEY / json_get KEY: stdin is a flat JSON object of strings. check: it is one, and it has KEY. get: prints
# KEY's value, decoded, exactly (run check first: get prints as it reads).
# shellcheck disable=SC2016 # an awk program: its $0 is awk's
json_awk='
function fail(m) { printf "%s: the request is not valid JSON (%s)\n", me, m > "/dev/stderr"; exit 2 }
function ws() { while (i <= n && index(" \t\r\n", substr(s, i, 1))) i++ }
function hex(h,   k, d, v) {
  v = 0
  for (k = 1; k <= 4; k++) {
    d = index("0123456789abcdef", tolower(substr(h, k, 1)))
    if (!d) fail("bad \\u escape")
    v = v * 16 + d - 1
  }
  return v
}
function str(emit, keep,   c, e, v, out) {
  if (substr(s, i, 1) != "\"") fail("a string was expected")
  i++
  out = ""
  for (;;) {
    if (i > n) fail("unterminated string")
    c = substr(s, i, 1)
    i++
    if (c == "\"") return out
    if (c == "\\") {
      e = substr(s, i, 1)
      i++
      if (e == "n") c = "\n"
      else if (e == "t") c = "\t"
      else if (e == "r") c = "\r"
      else if (e == "b") c = "\b"
      else if (e == "f") c = "\f"
      else if (e == "\"" || e == "\\" || e == "/") c = e
      else if (e == "u") {
        v = hex(substr(s, i, 4))
        i += 4
        if (v < 1 || v > 127) fail("only \\u0001-\\u007f escapes are read; xless writes other characters as UTF-8")
        c = sprintf("%c", v)
      } else fail("bad escape")
    }
    if (emit) printf "%s", c
    if (keep) out = out c
  }
}
{ s = s (NR > 1 ? "\n" : "") $0 }
END {
  n = length(s)
  i = 1
  ws()
  if (substr(s, i, 1) != "{") fail("an object was expected")
  i++
  ws()
  found = 0
  if (substr(s, i, 1) == "}") i++
  else for (;;) {
    ws()
    k = str(0, 1)
    ws()
    if (substr(s, i, 1) != ":") fail("a colon was expected")
    i++
    ws()
    if (k == want) found = 1
    str(k == want && mode == "get", 0)
    ws()
    c = substr(s, i, 1)
    i++
    if (c == "}") break
    if (c != ",") fail("a comma or a closing brace was expected")
  }
  ws()
  if (i <= n) fail("bytes after the object")
  if (!found) fail("no " want)
}'
json_check() { awk -v me="$me" -v mode=check -v want="$1" "$json_awk"; }
json_get() { awk -v me="$me" -v mode=get -v want="$1" "$json_awk"; }

# json_string: stdin is a value followed by one "x" (so trailing newlines survive $(...)); prints it as a JSON string.
json_string() {
  awk '
BEGIN {
  for (k = 1; k < 32; k++) esc[sprintf("%c", k)] = sprintf("\\u%04x", k)
  esc["\t"] = "\\t"; esc["\r"] = "\\r"; esc["\b"] = "\\b"; esc["\f"] = "\\f"
  esc[sprintf("%c", 127)] = "\\u007f"; esc["\""] = "\\\""; esc["\\"] = "\\\\"
}
{ line[NR] = $0 }
END {
  sub(/x$/, "", line[NR])
  printf "\""
  for (r = 1; r <= NR; r++) {
    if (r > 1) printf "\\n"
    m = length(line[r])
    for (k = 1; k <= m; k++) { c = substr(line[r], k, 1); printf "%s", ((c in esc) ? esc[c] : c) }
  }
  printf "\""
}'
}

# The entry name in a ServerURL (xless:<NAME>); anything else is refused.
name_of() {
  case $1 in
    xless:*) n=${1#xless:} ;;
    *) die "not an xless credential: $1" ;;
  esac
  case $n in
    '' | [!A-Za-z0-9]* | *[!A-Za-z0-9._@-]*) die "not an xless entry name: $n" ;;
  esac
  printf '%s' "$n"
}

# The items of xless (all, or the one named $1) as secret-tool prints them on stdout (paths, labels, values; the
# attributes go to stderr, with its errors, and are not used).
search() {
  err=$(mktemp) || die "cannot create a temporary file"
  if [ $# -gt 0 ]; then set -- xless-name "$1"; fi
  if secret-tool search --all application xless "$@" 2>"$err"; then rm -f "$err"; return 0; fi
  # No item at all is not an error (secret-tool says nothing then); anything it said is.
  if [ -s "$err" ]; then cat "$err" >&2; rm -f "$err"; die "secret-tool search failed"; fi
  rm -f "$err"
}

# found NAME?: name<TAB>username of the items (all, or NAME's); fails when the keyring cannot be searched.
found() {
  raw=$(search "$@" && printf x) || exit 1
  printf '%s' "${raw%x}" | items
}

# From `secret-tool search` output on stdin: name<TAB>username per item, from the first label line after each item's
# path (the value comes after it, and may span lines that look like anything), names checked.
items() {
  awk '
/^\[\/.*\]$/ { fresh = 1; next }
fresh && index($0, "label = xless ") == 1 {
  fresh = 0
  rest = substr($0, 15)
  cut = index(rest, " ")
  if (!cut) next
  name = substr(rest, 1, cut - 1)
  if (name ~ /^[A-Za-z0-9][A-Za-z0-9._@-]*$/) printf "%s\t%s\n", name, substr(rest, cut + 1)
  next
}
fresh && index($0, "label = ") == 1 { fresh = 0 }'
}

command -v secret-tool >/dev/null 2>&1 || die "secret-tool is not installed (libsecret-tools)"

case ${1:-} in
  get)
    url=$(cat)
    name=$(name_of "$url") || exit 1
    found=$(found "$name") || exit 1
    if [ -z "$found" ]; then
      echo "$not_found"
      exit 1
    fi
    first=${found%%"$nl"*}
    user=${first#*"$tab"}
    secret=$(secret-tool lookup application xless xless-name "$name" && printf x) || die "secret-tool could not read $name"
    printf '{"ServerURL":"xless:%s","Username":%s,"Secret":%s}\n' "$name" \
      "$(printf '%sx' "$user" | json_string)" "$(printf '%s' "$secret" | json_string)"
    ;;
  store)
    request=$(cat)
    for key in ServerURL Username Secret; do printf '%s' "$request" | json_check "$key" || exit 1; done
    name=$(name_of "$(printf '%s' "$request" | json_get ServerURL)") || exit 1
    user=$(printf '%s' "$request" | json_get Username && printf x) || exit 1
    user=${user%x}
    case $user in *"$nl"*) die "the description of $name spans lines" ;; esac
    size=$(printf '%s' "$request" | json_get Secret | wc -c | tr -d ' ')
    # secret-tool would keep the first 8191 bytes and still succeed.
    [ "$size" -lt 8192 ] || die "$name is $size bytes; secret-tool stores less than 8 KiB (use pass, or xless's own vault)"
    # Same attributes: secret-tool replaces the item (and its label), so the old value is kept until the new one is in.
    printf '%s' "$request" | json_get Secret |
      secret-tool store --label="xless $name $user" application xless xless-name "$name"
    ;;
  erase)
    url=$(cat)
    name=$(name_of "$url") || exit 1
    found=$(found "$name") || exit 1
    [ -n "$found" ] || { echo "$not_found"; exit 1; }
    secret-tool clear application xless xless-name "$name"
    ;;
  list)
    found=$(found) || exit 1
    out='{'
    sep=''
    while IFS="$tab" read -r name user; do
      [ -n "$name" ] || continue
      out="$out$sep\"xless:$name\":$(printf '%sx' "$user" | json_string)"
      sep=','
    done <<EOT
$found
EOT
    printf '%s}\n' "$out"
    ;;
  *)
    echo "usage: $me get|store|erase|list (xless's credential-helper protocol; see docs/secrets.md)" >&2
    exit 2
    ;;
esac
