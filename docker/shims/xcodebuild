#!/bin/sh
# Expo's ExpoModulesJSI build phase runs xcodebuild under `env -i` (PATH and HOME kept): restore the image settings the
# shim needs (the shims, and the store of Xcode packs, where the one pack a container mounts is found), and the image's
# SWIFT_DETERMINISTIC_HASHING (docker/Dockerfile), which the nested Swift Build run needs for the key order of the
# binary property lists it writes (the framework's Info.plist) not to change from run to run. Nothing else is set: a
# variable set here would override the pack's parts.
: "${XLESS_SHIM_DIR:=/opt/xless/shims}" "${XLESS_XCODES:=/xcodes}"
SWIFT_DETERMINISTIC_HASHING=1
export XLESS_SHIM_DIR XLESS_XCODES SWIFT_DETERMINISTIC_HASHING
exec xless shim xcodebuild "$@"
