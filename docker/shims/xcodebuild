#!/bin/sh
# Expo's ExpoModulesJSI build phase runs xcodebuild under `env -i` (PATH and HOME kept): restore the image settings the
# shim needs (the shims, and the store of Xcode packs, where the one pack a container mounts is found), and the image's
# SWIFT_DETERMINISTIC_HASHING (docker/Dockerfile), which the nested Swift Build run needs for the key order of the
# binary property lists it writes (the framework's Info.plist) not to change from run to run.
# What chooses the pack (XLESS_XCODES, XLESS_XCODE, XLESS_XCODE_PIN) comes from the nearest process above this one that
# still has the image's settings (the build phase's shell): with a whole store mounted, without them the nested build
# would take the newest pack, not the pinned one. Nothing else is set: a variable set here would override the pack's parts.
if [ -z "${XLESS_SHIM_DIR:-}" ]; then
  pid=$PPID
  while [ "${pid:-0}" -ge 1 ] && [ -r "/proc/$pid/environ" ]; do
    if tr '\0' '\n' < "/proc/$pid/environ" | grep -q '^XLESS_SHIM_DIR='; then
      for name in XLESS_XCODES XLESS_XCODE XLESS_XCODE_PIN; do
        value=$(tr '\0' '\n' < "/proc/$pid/environ" | sed -n "s/^$name=//p" | head -n 1)
        if [ -n "$value" ]; then eval "$name=\$value"; export "${name?}"; fi
      done
      break
    fi
    pid=$(sed -n 's/^PPid:[[:space:]]*//p' "/proc/$pid/status" 2>/dev/null)
  done
fi
: "${XLESS_SHIM_DIR:=/opt/xless/shims}" "${XLESS_XCODES:=/xcodes}"
SWIFT_DETERMINISTIC_HASHING=1
export XLESS_SHIM_DIR XLESS_XCODES SWIFT_DETERMINISTIC_HASHING
exec xless shim xcodebuild "$@"
